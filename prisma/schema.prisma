generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleLevel {
  ADMIN
  MANAGER
  USER
}

enum SoapMethod {
  GETSCHEMA
  READRECORD
  READVIEW
  SAVERECORD
  DELETERECORD
  DELETERECORDBYKEY
  ISVALIDDATASERVER
  EXECUTEPROCESS
  EXECUTEWITHXMLPARAMS
  EXECUTEWITHXMLPARAMSASYNC
  GETPROCESSSTATUS
  GETSCHEMA2
  CHECKSERVICEACTIVITY
  REALIZARCONSULTASQL
  REALIZARCONSULTASQLCONTEXTO
  AUTENTICAACESSO
  GETREPORTLIST
  GETREPORTMETADATA
  GETREPORTINFO
  GENERATEREPORT
  GENERATEREPORTASYNCHRONOUS
  GETGENERATEDREPORTSTATUS
  GETGENERATEDREPORTSIZE
  GETFILECHUNK
  GETPARAMETERS
  EXECUTE
}

enum DemandStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageTemplateEvent {
  CONTRACT_USAGE
  BACKUP_FAILED
  SOAP_FAILED
  GENERAL
  DEMAND_REPORT
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BackupSchedule {
  NONE
  EVERY_3H
  EVERY_6H
  EVERY_12H
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum BackupRunStatus {
  RUNNING
  ERROR
  DONE
}

enum BackupRestoreStatus {
  NOT_RESTORED
  RESTORED
  ERROR
}

enum FichaAutomationStatus {
  RUNNING
  DONE
  ERROR
  PARTIAL
}

enum FichaAutomationStepStatus {
  SUCCESS
  FAILED
  PENDING
  SKIPPED
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  document  String?
  plan      String    @default("free")
  status    Boolean   @default(true)
  configs   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                  User[]
  roles                  Role[]
  clients                Client[]
  tbcs                   Tbc[]
  filters                Filter[]
  backups                Backup[]
  backupRuns             BackupRun[]
  sentenceCategories     SentenceCategory[]
  sentences              Sentence[]
  dataservers            Dataserver[]
  processes              Process[]
  totvsSystems           TotvsSystem[]
  soapLogs               SoapLog[]
  soapTemplates          SoapTemplate[]
  soapFavorites          SoapFavorite[]
  auditLogs              AuditLog[]
  emailLogs              EmailLog[]
  apiLogs                ApiLog[]
  requesters             Requester[]
  departments            Department[]
  demandTypes            DemandType[]
  tags                   Tag[]
  analysts               Analyst[]
  demands                Demand[]
  notifications          Notification[]
  emailSettings          EmailSettings?
  aiSettings             AiSettings?
  demandReportSchedules  DemandReportSchedule[]
  usageAlerts            ContractUsageAlert[]
  messageTemplates       MessageTemplate[]
  fichaAutomationRuns    FichaAutomationRun[]
  mapeadorProjetos       MapeadorProjeto[]
  mapeadorTemas          MapeadorTema[]
  mapeadorTemplates      MapeadorTemplateProjeto[]
  tbcChecklists          TbcChecklist[]
  projects               Project[]
  projectTasks           ProjectTask[]
  projectTimeEntries     ProjectTimeEntry[]
  customFieldDefinitions CustomFieldDefinition[]
  projectTaskDueAlerts   ProjectTaskDueAlert[]

  @@map("organizations")
}

model SoapEndpointType {
  id        String   @id @default(uuid())
  type      String   @unique
  label     String
  suffix    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  methods  SoapEndpointMethod[]
  soapLogs SoapLog[]

  @@map("soap_endpoint_types")
}

model SoapEndpointMethod {
  id             String   @id @default(uuid())
  endpointTypeId String   @map("endpoint_type_id")
  method         String
  label          String
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  endpointType SoapEndpointType @relation(fields: [endpointTypeId], references: [id])

  soapLogs SoapLog[]

  @@map("soap_endpoint_methods")
}

model User {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  name              String
  email             String        @unique
  password          String
  image             String?
  role              UserRoleLevel @default(USER)
  status            Boolean       @default(true)
  changePassword    Boolean       @default(false) @map("change_password")
  /// Sessions signed in before this instant are rejected (password changed/reset elsewhere).
  passwordChangedAt DateTime?     @map("password_changed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  organization         Organization          @relation(fields: [organizationId], references: [id])
  auditLogs            AuditLog[]
  soapLogs             SoapLog[]
  soapTemplates        SoapTemplate[]
  soapFavorites        SoapFavorite[]
  emailLogs            EmailLog[]
  apiLogs              ApiLog[]
  userRoles            UserRole[]
  analyst              Analyst?
  comments             Comment[]
  uploadedAttachments  Attachment[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  backupRuns           BackupRun[]
  filtersLastBackedUp  Filter[]
  backupsRestored      Backup[]
  allowedClients       UserClient[]
  fichaAutomationRuns  FichaAutomationRun[]
  managedProjects      Project[]             @relation("ProjectManager")
  projectMemberships   ProjectMember[]
  assignedProjectTasks ProjectTask[]         @relation("ProjectTaskAssignee")
  projectTimeEntries   ProjectTimeEntry[]
  projectTaskComments  ProjectTaskComment[]
  ownedProjectRisks    ProjectRisk[]         @relation("ProjectRiskOwner")

  @@map("users")
}

/**
 * Restricts which clients a user can see data for — enforced on Filters, Contracts, TBCs and Backups.
 */
model UserClient {
  userId   String @map("user_id")
  clientId String @map("client_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("user_clients")
}

model Dataserver {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  code            String
  nameAlternative String?   @map("name_alternative")
  name            String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("dataservers")
}

model Process {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  code            String
  nameAlternative String?   @map("name_alternative")
  name            String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("processes")
}

model Client {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  image          String?
  favicon        String?
  background     String?
  name           String
  legalName      String?   @map("legal_name")
  document       String?
  linkCrm        String?   @map("link_crm")
  site           String?
  email          String?
  phone          String?
  responsible    String?
  color          String    @default("#22c55e")
  notes          String?   @db.Text
  favorite       Boolean   @default(false)
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization     Organization         @relation(fields: [organizationId], references: [id])
  tbcs             Tbc[]
  filters          Filter[]
  contracts        ClientContract[]
  demands          Demand[]
  userClients      UserClient[]
  mapeadorProjetos MapeadorProjeto[]
  usageAlerts      ContractUsageAlert[]
  projects         Project[]

  @@unique([organizationId, linkCrm])
  @@map("clients")
}

model Tbc {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  clientId           String    @map("client_id")
  name               String
  link               String
  user               String
  password           String
  notRequiredLicense Boolean   @default(false) @map("not_required_license")
  status             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization    Organization   @relation(fields: [organizationId], references: [id])
  client          Client         @relation(fields: [clientId], references: [id])
  filters         Filter[]
  backups         Backup[]       @relation("BackupTbc")
  restoredBackups Backup[]       @relation("BackupRestoredToTbc")
  checklists      TbcChecklist[]

  @@unique([organizationId, link])
  @@index([clientId])
  @@map("tbcs")
}

/// A named, user-built configuration checklist of one TBC: which Data Servers (and which of their
/// fields) to validate, plus the Contexto and processo-listing setup of the checklist screen.
model TbcChecklist {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  tbcId                 String    @map("tbc_id")
  name                  String
  coligateContext       Int?      @map("coligate_context")
  branchContext         Int?      @map("branch_context")
  levelEducationContext Int?      @map("level_education_context")
  listingDataserverCode String?   @map("listing_dataserver_code")
  listingIdFields       String[]  @default([]) @map("listing_id_fields")
  listingLabelField     String?   @map("listing_label_field")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  organization Organization             @relation(fields: [organizationId], references: [id])
  tbc          Tbc                      @relation(fields: [tbcId], references: [id])
  dataservers  TbcChecklistDataserver[]
  processos    TbcChecklistProcesso[]

  @@index([tbcId])
  @@map("tbc_checklists")
}

/// Processo seletivo picked for a TbcChecklist — saved so the checklist screen doesn't re-list
/// every processo from TOTVS on each visit. coligada + IDPS are the key the checklist is loaded by;
/// filial + nível de ensino complete the SOAP Contexto.
model TbcChecklistProcesso {
  id             String   @id @default(uuid())
  checklistId    String   @map("checklist_id")
  codColigada    Int      @map("cod_coligada")
  codFilial      Int      @map("cod_filial")
  levelEducation Int      @map("level_education")
  idps           Int
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  checklist TbcChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, codColigada, idps])
  @@map("tbc_checklist_processos")
}

/// One Data Server of a TbcChecklist and the fields picked for validation — `fields` is
/// `{ table: string; name: string }[]` (tables as GetSchema names them).
model TbcChecklistDataserver {
  id             String   @id @default(uuid())
  checklistId    String   @map("checklist_id")
  dataserverCode String   @map("dataserver_code")
  position       Int      @default(0)
  fields         Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  checklist TbcChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, dataserverCode])
  @@map("tbc_checklist_dataservers")
}

model Filter {
  id                    String           @id @default(uuid())
  organizationId        String           @map("organization_id")
  tbcId                 String           @map("tbc_id")
  clientId              String           @map("client_id")
  filter                String
  coligateContext       Int              @map("coligate_context")
  branchContext         Int              @map("branch_context")
  levelEducationContext Int              @map("level_education_context")
  codSystemContext      String           @map("cod_system_context")
  userContext           String           @map("user_context")
  codColigadaSentenca   String           @map("cod_coligada_sentenca")
  codSistemaSentenca    String           @map("cod_sistema_sentenca")
  status                Boolean          @default(true)
  lastBackupStatus      BackupRunStatus? @map("last_backup_status")
  lastBackupAt          DateTime?        @map("last_backup_at")
  lastBackupByUserId    String?          @map("last_backup_by_user_id")
  schedule              BackupSchedule   @default(NONE)
  scheduleTime          String?          @map("schedule_time")
  scheduleCategoryId    String?          @map("schedule_category_id")
  nextRunAt             DateTime?        @map("next_run_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  tbc              Tbc               @relation(fields: [tbcId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id])
  lastBackupBy     User?             @relation(fields: [lastBackupByUserId], references: [id])
  scheduleCategory SentenceCategory? @relation(fields: [scheduleCategoryId], references: [id])
  backups          Backup[]
  backupRuns       BackupRun[]

  @@index([nextRunAt])
  @@index([organizationId, clientId])
  @@map("filters")
}

model BackupRun {
  id               String          @id @default(uuid())
  organizationId   String          @map("organization_id")
  filterId         String          @map("filter_id")
  status           BackupRunStatus @default(RUNNING)
  errorMessage     String?         @map("error_message")
  executedByUserId String?         @map("executed_by_user_id")
  startedAt        DateTime        @default(now()) @map("started_at")
  finishedAt       DateTime?       @map("finished_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  filter       Filter       @relation(fields: [filterId], references: [id])
  executedBy   User?        @relation(fields: [executedByUserId], references: [id])
  backups      Backup[]

  @@index([filterId, startedAt])
  @@map("backup_runs")
}

model Backup {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  tbcId              String              @map("tbc_id")
  filterId           String              @map("filter_id")
  backupRunId        String?             @map("backup_run_id")
  sentenceCategoryId String?             @map("sentence_category_id")
  branchSentence     String?             @map("branch_sentence")
  codColigada        String?             @map("cod_coligada")
  codSystem          String?             @map("cod_system")
  codeSentence       String?             @map("code_sentence")
  nameSentence       String?             @map("name_sentence")
  contentSentence    String?             @map("content_sentence")
  hash               String?
  isLatest           Boolean             @default(true) @map("is_latest")
  totvsUpdatedAt     DateTime?           @map("totvs_updated_at")
  totvsUpdatedBy     String?             @map("totvs_updated_by")
  restoreStatus      BackupRestoreStatus @default(NOT_RESTORED) @map("restore_status")
  restoredAt         DateTime?           @map("restored_at")
  restoredByUserId   String?             @map("restored_by_user_id")
  restoredToTbcId    String?             @map("restored_to_tbc_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  tbc              Tbc               @relation("BackupTbc", fields: [tbcId], references: [id])
  filter           Filter            @relation(fields: [filterId], references: [id])
  backupRun        BackupRun?        @relation(fields: [backupRunId], references: [id])
  sentenceCategory SentenceCategory? @relation(fields: [sentenceCategoryId], references: [id])
  restoredBy       User?             @relation(fields: [restoredByUserId], references: [id])
  restoredToTbc    Tbc?              @relation("BackupRestoredToTbc", fields: [restoredToTbcId], references: [id])

  @@index([filterId, isLatest, codeSentence])
  @@index([backupRunId])
  @@map("backups")
}

model FichaAutomationRun {
  id                   String                @id @default(uuid())
  organizationId       String                @map("organization_id")
  userId               String?               @map("user_id")
  idPs                 String                @map("id_ps")
  pageUrl              String                @map("page_url")
  status               FichaAutomationStatus @default(RUNNING)
  finalSubmitConfirmed Boolean               @default(false) @map("final_submit_confirmed")
  errorMessage         String?               @map("error_message")
  startedAt            DateTime              @default(now()) @map("started_at")
  finishedAt           DateTime?             @map("finished_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])
  steps        FichaAutomationStep[]

  @@map("ficha_automation_runs")
}

model FichaAutomationStep {
  id           String                    @id @default(uuid())
  runId        String                    @map("run_id")
  order        Int
  etapaNome    String                    @map("etapa_nome")
  passoNome    String?                   @map("passo_nome")
  kind         String
  status       FichaAutomationStepStatus @default(PENDING)
  durationMs   Int?                      @map("duration_ms")
  fieldsFilled Int?                      @map("fields_filled")
  fieldsFailed Int?                      @map("fields_failed")
  errorMessage String?                   @map("error_message")
  details      Json?
  createdAt    DateTime                  @default(now()) @map("created_at")

  run FichaAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("ficha_automation_steps")
}

model SentenceCategory {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  code           String
  name           String
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sentences    Sentence[]
  backups      Backup[]
  filters      Filter[]

  @@unique([organizationId, code])
  @@map("sentence_categories")
}

model Sentence {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  sentenceCategoryId String    @map("sentence_categories_id")
  code               String
  codSystem          String?   @map("cod_system")
  codColigada        String?   @map("cod_coligada")
  name               String
  content            String?   @map("content")
  status             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     SentenceCategory @relation(fields: [sentenceCategoryId], references: [id])

  @@unique([organizationId, code])
  @@map("sentences")
}

model TotvsSystem {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  code           String
  internalName   String    @map("internal_name")
  externalName   String    @map("external_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("totvs_systems")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  action         String
  entity         String
  entityId       String   @map("entity_id")
  userId         String?  @map("user_id")
  oldData        Json?    @map("old_data")
  newData        Json?    @map("new_data")
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SoapLog {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  endpointTypeId String?     @map("endpoint_type_id")
  methodId       String?     @map("method_id")
  dataserver     String?
  process        String?
  method         SoapMethod?
  xmlRequest     String?     @map("xml_request")
  xmlResponse    String?     @map("xml_response")
  jsonResponse   Json?       @map("json_response")
  status         Int?
  duration       Int?
  error          String?
  context        Json?
  favorite       Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")

  organization   Organization        @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])
  endpointType   SoapEndpointType?   @relation(fields: [endpointTypeId], references: [id])
  endpointMethod SoapEndpointMethod? @relation(fields: [methodId], references: [id])

  @@index([organizationId, createdAt])
  @@map("soap_logs")
}

model EmailLog {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String?        @map("user_id")
  to             String
  subject        String
  status         EmailLogStatus
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("email_logs")
}

enum EmailLogStatus {
  SENT
  FAILED
  SKIPPED
}

model ApiLog {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String?  @map("user_id")
  integration     String
  url             String
  httpMethod      String   @map("http_method")
  httpStatus      Int?     @map("http_status")
  duration        Int?
  error           String?
  requestSummary  Json?    @map("request_summary")
  responseSummary Json?    @map("response_summary")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("api_logs")
}

model SoapTemplate {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  name           String
  description    String?
  dataserver     String?
  process        String?
  method         SoapMethod?
  xmlTemplate    String?     @map("xml_template")
  context        Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@map("soap_templates")
}

model SoapFavorite {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String      @map("user_id")
  name           String
  dataserver     String?
  process        String?
  method         SoapMethod?
  xml            String?
  context        Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("soap_favorites")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model FeatureFlag {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(false)
  roles     String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model UploadedFile {
  id         String   @id @default(uuid())
  name       String
  size       Int
  type       String
  path       String
  entity     String?
  entityId   String?  @map("entity_id")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("uploaded_files")
}

model Analyst {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String?   @unique @map("user_id")
  name           String
  email          String?
  phone          String?
  role           String?
  hourlyRate     Float?    @map("hourly_rate")
  status         Boolean   @default(true)
  photo          String?
  team           String?
  color          String    @default("#6366f1")
  level          Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  demands      Demand[]

  @@map("analysts")
}

model ClientContract {
  id              String         @id @default(uuid())
  clientId        String         @map("client_id")
  contractedHours Float          @map("contracted_hours")
  startDate       DateTime       @map("start_date")
  endDate         DateTime?      @map("end_date")
  status          ContractStatus @default(ACTIVE)
  notifyClient    Boolean        @default(false) @map("notify_client")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([clientId, status])
  @@map("client_contracts")
}

/// One row per (client, month, threshold) already alerted — guarantees each usage threshold
/// (80/85/90/95/100%) is notified only once per client per month.
model ContractUsageAlert {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  clientId        String   @map("client_id")
  period          String
  threshold       Int
  usedHours       Float    @map("used_hours")
  contractedHours Float    @map("contracted_hours")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period, threshold])
  @@map("contract_usage_alerts")
}

/// Email/WhatsApp message template. For EMAIL, `content` (block tree, see
/// lib/message-templates/block-types.ts) is the source of truth and `bodyHtml` a render cache;
/// for WHATSAPP, `bodyText` holds the message with WhatsApp markup. The newest active template
/// of an (event, channel) pair is the one used when sending.
model MessageTemplate {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  event          MessageTemplateEvent
  channel        MessageChannel
  subject        String               @default("")
  content        Json?
  bodyHtml       String               @default("") @map("body_html") @db.Text
  bodyText       String               @default("") @map("body_text") @db.Text
  /// Generated files attached on send (EMAIL only) — e.g. the demands spreadsheet (see lib/message-templates/attachments.ts).
  attachments    Json?
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  organization          Organization           @relation(fields: [organizationId], references: [id])
  demandReportSchedules DemandReportSchedule[]

  @@index([organizationId, event, channel, isActive])
  @@map("message_templates")
}

model Requester {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  email          String?
  phone          String?
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  demands      Demand[]

  @@map("requesters")
}

model Department {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  demands      Demand[]

  @@map("departments")
}

model DemandType {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?   @db.Text
  color          String    @default("#a855f7")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  demands      Demand[]

  @@map("demand_types")
}

model Demand {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  name            String
  description     String       @db.Text
  date            DateTime
  startTime       DateTime?    @map("start_time")
  endTime         DateTime?    @map("end_time")
  durationMinutes Int          @map("duration_minutes")
  priority        Priority     @default(MEDIUM)
  status          DemandStatus @default(PENDING)
  notes           String?      @db.Text
  analystId       String       @map("analyst_id")
  clientId        String       @map("client_id")
  requesterId     String?      @map("requester_id")
  departmentId    String?      @map("department_id")
  demandTypeId    String?      @map("demand_type_id")
  /// Gestão de Projetos: hours logged for a project (and optionally one of its tasks).
  projectId       String?      @map("project_id")
  projectTaskId   String?      @map("project_task_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  analyst      Analyst      @relation(fields: [analystId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  requester    Requester?   @relation(fields: [requesterId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  demandType   DemandType?  @relation(fields: [demandTypeId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  projectTask  ProjectTask? @relation(fields: [projectTaskId], references: [id])
  attachments  Attachment[]
  comments     Comment[]
  demandTags   DemandTag[]

  @@index([organizationId, deletedAt, date])
  @@index([clientId])
  @@index([analystId])
  @@index([projectId])
  @@index([projectTaskId])
  @@map("demands")
}

model Attachment {
  id           String   @id @default(uuid())
  demandId     String   @map("demand_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  url          String
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  demand     Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}

model Comment {
  id        String   @id @default(uuid())
  demandId  String   @map("demand_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand  Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  color          String   @default("#8b5cf6")
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  demandTags      DemandTag[]
  projectTaskTags ProjectTaskTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model DemandTag {
  demandId String @map("demand_id")
  tagId    String @map("tag_id")

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([demandId, tagId])
  @@index([tagId])
  @@map("demand_tags")
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  type           String
  title          String
  body           String    @db.Text
  data           Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationSetting {
  id      String              @id @default(uuid())
  userId  String              @map("user_id")
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_settings")
}

/**
 * A mapped enrollment process (e.g. "Vestibular Presencial") — the Rubeus Mapeador de Experiências equivalent.
 */
model MapeadorProjeto {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  clienteId             String?   @map("cliente_id")
  nome                  String
  informacoesAdicionais Json?     @map("informacoes_adicionais")
  prototipoConfig       Json?     @map("prototipo_config")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  cliente      Client?         @relation(fields: [clienteId], references: [id])
  etapas       MapeadorEtapa[]

  @@map("mapeador_projetos")
}

/**
 * One step of a MapeadorProjeto's ficha — camposPorEtapa holds the free-form passos/campos tree (same shape import/export JSON uses).
 */
model MapeadorEtapa {
  id             String   @id @default(uuid())
  projetoId      String   @map("projeto_id")
  ordem          Int
  nome           String
  condicao       String?
  regras         String?  @db.Text
  camposPorEtapa Json?    @map("campos_por_etapa")
  feedbacks      Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  projeto MapeadorProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@map("mapeador_etapas")
}

/**
 * Reusable Protótipo visual appearance preset (brand/bar color, field/button style, logo, background), shared across every MapeadorProjeto in the organization.
 */
model MapeadorTema {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  nome           String
  config         Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("mapeador_temas")
}

/**
 * A reusable snapshot of a MapeadorProjeto's etapas/campos structure, saved by the user from an
 * existing project ("Salvar como modelo") — sits alongside the static "Padrão Rubeus" templates
 * as a starting point for new projects, but authored and owned by the organization instead of
 * shipped in code. No FK to the source MapeadorProjeto — it's a point-in-time copy, same as the
 * static templates.
 */
model MapeadorTemplateProjeto {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  nome                  String
  informacoesAdicionais Json?    @map("informacoes_adicionais")
  etapas                Json
  /**
   * When true, this modelo replaces the static "Padrão Rubeus" template of the same `nome` for the organization — see mapeadorTemplateService.setPadrao.
   */
  isPadrao              Boolean  @default(false) @map("is_padrao")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("mapeador_templates_projeto")
}

/**
 * SMTP credentials for the EMAIL notification channel — configured per organization here instead of fixed .env vars.
 */
model EmailSettings {
  id                 String   @id @default(uuid())
  organizationId     String   @unique @map("organization_id")
  host               String
  port               Int
  user               String
  password           String
  from               String
  enabled            Boolean  @default(true)
  contractAlertEmail String?  @map("contract_alert_email")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("email_settings")
}

/// Per-organization AI provider used by the demand assistant (/integrations/ai). `apiKey` is
/// encrypted with lib/secret-box.ts and never returned to the client.
model AiSettings {
  id             String     @id @default(uuid())
  organizationId String     @unique @map("organization_id")
  provider       AiProvider @default(ANTHROPIC)
  model          String
  apiKey         String     @map("api_key")
  enabled        Boolean    @default(true)
  /// Extra instructions appended to the assistant's system prompt (house rules, defaults...).
  instructions   String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("ai_settings")
}

/// Automated "demands report" email: one email per client with demands in the period, rendered from
/// a DEMAND_REPORT template (which carries the XLSX attachment), sent to `toEmails` with `ccEmails` in copy.
model DemandReportSchedule {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  name              String
  templateId        String         @map("template_id")
  /// Reference period, relative to the send date — see lib/report-period.ts (currentMonth, previousMonth, ...).
  period            String         @default("currentMonth")
  /// Empty = every client (of the organization) with demands in the period.
  clientIds         String[]       @default([]) @map("client_ids")
  toEmails          String[]       @default([]) @map("to_emails")
  ccEmails          String[]       @default([]) @map("cc_emails")
  /// Also sends to the client's own e-mail (Client.email), when filled.
  sendToClientEmail Boolean        @default(false) @map("send_to_client_email")
  schedule          BackupSchedule @default(NONE)
  scheduleTime      String?        @map("schedule_time")
  /// MONTHLY only: day of the month (1-31, clamped to the month's last day); null = last day of the month.
  dayOfMonth        Int?           @map("day_of_month")
  isActive          Boolean        @default(true) @map("is_active")
  nextRunAt         DateTime?      @map("next_run_at")
  lastRunAt         DateTime?      @map("last_run_at")
  lastRunStatus     String?        @map("last_run_status")
  lastRunMessage    String?        @map("last_run_message") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  template     MessageTemplate @relation(fields: [templateId], references: [id])

  @@index([organizationId, deletedAt])
  @@index([isActive, nextRunAt])
  @@map("demand_report_schedules")
}

// ── Gestão de Projetos ────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  GREEN
  YELLOW
  RED
}

enum ProjectTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum ProjectDependencyType {
  FINISH_TO_START
}

enum ProjectRiskStatus {
  OPEN
  MITIGATING
  OCCURRED
  CLOSED
}

enum CustomFieldEntity {
  PROJECT
  TASK
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
  USER
  URL
  CHECKBOX
  CHECKBOX_GROUP
  DATETIME
  TIME
}

enum ProjectDueAlertKind {
  DUE_SOON
  OVERDUE
}

/**
 * Managed project (Gestão de Projetos) — the project charter. `status` is the lifecycle (like
 * ClientContract.status), not an active flag. `progress` is denormalized from tasks
 * (lib/project-metrics.ts) so the list can sort by it; `health` null = computed on read.
 * Time logged on tasks of a project with `contractId` consumes the client's contract hours.
 */
model Project {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  code             String
  name             String
  description      String?        @db.Text
  objective        String?        @db.Text
  scope            String?        @db.Text
  outOfScope       String?        @map("out_of_scope") @db.Text
  assumptions      String?        @db.Text
  successCriteria  String?        @map("success_criteria") @db.Text
  clientId         String?        @map("client_id")
  contractId       String?        @map("contract_id")
  managerId        String?        @map("manager_id")
  sponsorName      String?        @map("sponsor_name")
  status           ProjectStatus  @default(PLANNING)
  health           ProjectHealth?
  priority         Priority       @default(MEDIUM)
  plannedStartDate DateTime?      @map("planned_start_date")
  plannedEndDate   DateTime?      @map("planned_end_date")
  actualStartDate  DateTime?      @map("actual_start_date")
  actualEndDate    DateTime?      @map("actual_end_date")
  budgetHours      Float?         @map("budget_hours")
  budgetAmount     Float?         @map("budget_amount")
  progress         Float          @default(0)
  color            String         @default("#6366f1")
  /// { wipLimits?: Partial<Record<ProjectTaskStatus, number>>, wipEnforced?: boolean, dueSoonDays?: number }
  settings         Json?
  /// Values of CustomFieldDefinition (entity PROJECT), keyed by definition id.
  customFields     Json           @default("{}") @map("custom_fields")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  client       Client?            @relation(fields: [clientId], references: [id])
  contract     ClientContract?    @relation(fields: [contractId], references: [id])
  manager      User?              @relation("ProjectManager", fields: [managerId], references: [id])
  members      ProjectMember[]
  tasks        ProjectTask[]
  timeEntries  ProjectTimeEntry[]
  risks        ProjectRisk[]
  stages       ProjectStage[]
  phases       ProjectPhase[]
  demands      Demand[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt, status])
  @@index([clientId])
  @@index([contractId])
  @@index([managerId])
  @@map("projects")
}

model ProjectMember {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  userId            String   @map("user_id")
  role              String?
  allocationPercent Int?     @map("allocation_percent")
  createdAt         DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/**
 * Task/activity of a Project. `boardPosition` orders cards inside a kanban column and
 * `outlinePosition` orders siblings in the WBS (list/gantt) — both fractional (lib/project-tasks.ts).
 */
model ProjectTask {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  projectId       String            @map("project_id")
  parentId        String?           @map("parent_id")
  stageId         String?           @map("stage_id")
  phaseId         String?           @map("phase_id")
  number          Int
  title           String
  description     String?           @db.Text
  status          ProjectTaskStatus @default(TODO)
  priority        Priority          @default(MEDIUM)
  assigneeId      String?           @map("assignee_id")
  startDate       DateTime?         @map("start_date")
  dueDate         DateTime?         @map("due_date")
  completedAt     DateTime?         @map("completed_at")
  estimateHours   Float?            @map("estimate_hours")
  loggedMinutes   Int               @default(0) @map("logged_minutes")
  progress        Int               @default(0)
  isMilestone     Boolean           @default(false) @map("is_milestone")
  boardPosition   Float             @default(0) @map("board_position")
  outlinePosition Float             @default(0) @map("outline_position")
  /// Values of CustomFieldDefinition (entity TASK), keyed by definition id.
  customFields    Json              @default("{}") @map("custom_fields")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  organization   Organization               @relation(fields: [organizationId], references: [id])
  project        Project                    @relation(fields: [projectId], references: [id])
  parent         ProjectTask?               @relation("ProjectTaskTree", fields: [parentId], references: [id])
  stage          ProjectStage?              @relation(fields: [stageId], references: [id])
  phase          ProjectPhase?              @relation(fields: [phaseId], references: [id])
  demands        Demand[]
  children       ProjectTask[]              @relation("ProjectTaskTree")
  assignee       User?                      @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])
  predecessors   ProjectTaskDependency[]    @relation("DependencySuccessor")
  successors     ProjectTaskDependency[]    @relation("DependencyPredecessor")
  timeEntries    ProjectTimeEntry[]
  comments       ProjectTaskComment[]
  checklistItems ProjectTaskChecklistItem[]
  tags           ProjectTaskTag[]
  dueAlerts      ProjectTaskDueAlert[]

  @@unique([projectId, number])
  @@index([projectId, deletedAt, status, boardPosition])
  @@index([parentId])
  @@index([stageId])
  @@index([phaseId])
  @@index([assigneeId, status])
  @@index([organizationId, dueDate])
  @@map("project_tasks")
}

model ProjectTaskDependency {
  id            String                @id @default(uuid())
  predecessorId String                @map("predecessor_id")
  successorId   String                @map("successor_id")
  type          ProjectDependencyType @default(FINISH_TO_START)
  lagDays       Int                   @default(0) @map("lag_days")
  createdAt     DateTime              @default(now()) @map("created_at")

  predecessor ProjectTask @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ProjectTask @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@map("project_task_dependencies")
}

/// Hours logged on a task. `projectId` is denormalized for the contract-usage groupBy.
model ProjectTimeEntry {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  taskId         String    @map("task_id")
  userId         String    @map("user_id")
  date           DateTime
  minutes        Int
  note           String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  task         ProjectTask  @relation(fields: [taskId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, deletedAt, date])
  @@index([projectId, date])
  @@index([taskId])
  @@index([userId, date])
  @@map("project_time_entries")
}

model ProjectTaskComment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@map("project_task_comments")
}

model ProjectTaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("project_task_checklist_items")
}

/// Reuses the org Tag catalog (same as DemandTag).
model ProjectTaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("project_task_tags")
}

model ProjectRisk {
  id             String            @id @default(uuid())
  projectId      String            @map("project_id")
  title          String
  description    String?           @db.Text
  /// 1–5
  probability    Int               @default(3)
  /// 1–5
  impact         Int               @default(3)
  status         ProjectRiskStatus @default(OPEN)
  ownerId        String?           @map("owner_id")
  mitigationPlan String?           @map("mitigation_plan") @db.Text
  dueDate        DateTime?         @map("due_date")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id])
  owner   User?   @relation("ProjectRiskOwner", fields: [ownerId], references: [id])

  @@index([projectId])
  @@map("project_risks")
}

/**
 * Org-level custom field ("campo complementar") created from the UI — no migration per field.
 * Values live in Project/ProjectTask.customFields keyed by this id. `options` = [{ id, label, color? }]
 * for SELECT/MULTISELECT; values store option ids so renaming a label is safe.
 */
model CustomFieldDefinition {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  entity         CustomFieldEntity
  label          String
  type           CustomFieldType
  helpText       String?           @map("help_text")
  required       Boolean           @default(false)
  options        Json?
  position       Int               @default(0)
  showInList     Boolean           @default(false) @map("show_in_list")
  /// Validation rules per type (lib/custom-fields.ts CustomFieldConfig): minLength/maxLength, min/max, dates, times, selections.
  config         Json?
  status         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entity, deletedAt, status, position])
  @@map("custom_field_definitions")
}

/**
 * Dedup for deadline alerts, like ContractUsageAlert: one row per (task, recipient, kind, due date
 * snapshot) — changing the due date or the assignee yields a new key, so no reset logic is needed.
 * `userId` deliberately has no @relation so it never blocks deleting a user.
 */
model ProjectTaskDueAlert {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  taskId         String              @map("task_id")
  userId         String              @map("user_id")
  kind           ProjectDueAlertKind
  dueDate        DateTime            @map("due_date")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  task         ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, kind, dueDate])
  @@map("project_task_due_alerts")
}

/**
 * Workflow stage (kanban column) of a Project, defined per project. `category` says how the stage
 * counts for metrics — ProjectTask.status mirrors the category of the task's stage, so progress,
 * health, alerts and burndown keep working on the fixed status set.
 */
model ProjectStage {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  name      String
  color     String            @default("#6366f1")
  position  Float             @default(0)
  category  ProjectTaskStatus @default(TODO)
  wipLimit  Int?              @map("wip_limit")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")

  project Project       @relation(fields: [projectId], references: [id])
  tasks   ProjectTask[]

  @@index([projectId, deletedAt, position])
  @@map("project_stages")
}

/// Macro phase of a Project (e.g. Iniciação, Planejamento, Execução, Encerramento), with dates.
model ProjectPhase {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  color       String    @default("#0ea5e9")
  position    Float     @default(0)
  description String?   @db.Text
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project Project       @relation(fields: [projectId], references: [id])
  tasks   ProjectTask[]

  @@index([projectId, deletedAt, position])
  @@map("project_phases")
}
