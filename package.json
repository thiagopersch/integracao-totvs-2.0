    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
