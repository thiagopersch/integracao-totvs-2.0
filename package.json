    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.7.1",
