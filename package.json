{
  "name": "integracao-totvs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy --schema=prisma/schema.prisma && tsx scripts/sync-permissions.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma && tsx scripts/generate-relations.ts",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "sync:permissions": "tsx scripts/sync-permissions.ts",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "postinstall": "prisma generate --schema=prisma/schema.prisma && tsx scripts/generate-relations.ts",
    "setup": "docker compose down -v && docker compose up -d --wait postgres && npx prisma migrate dev --schema=prisma/schema.prisma --name init && npx tsx prisma/seed.ts && npm run dev",
    "setup:win": "setup.bat",
    "setup:unix": "bash setup.sh",
    "start:dev": "docker compose up --watch",
    "start:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "start:down": "docker compose down",
    "start:logs": "docker compose logs -f app",
    "start:seed": "docker compose run --rm migrate npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
