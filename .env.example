# Database
DATABASE_URL="postgresql://admin:admin123@localhost:5432/integracao_totvs"
DB_NAME=integracao_totvs
DB_USER=admin
DB_PASS=admin123

# Porta no host para o Postgres do docker-compose (5432 padrão do container é sempre interno)
DB_PORT=5433

# Auth.js (gere com: npx auth secret)
AUTH_SECRET=change-this-to-a-long-random-string

# Criptografia (AES-256-GCM) das senhas de TBC/TOTVS RM e SMTP — gere com: openssl rand -base64 32
# Guarde-a com segurança: perder a chave obriga a redigitar todas as senhas de TBC e SMTP.
CREDENTIALS_ENCRYPTION_KEY=

# URL sem pooler (Neon "unpooled"/direta) — usada pelo LISTEN das notificações em tempo real e
# pelas migrations. Na Vercel a integração do Neon injeta DATABASE_URL_UNPOOLED automaticamente.
DATABASE_URL_UNPOOLED=

# Pool do Postgres (padrões entre parênteses)
# DATABASE_POOL_MAX=              (20)
# DATABASE_IDLE_TIMEOUT_MS=       (10000)
# DATABASE_CONNECT_TIMEOUT_MS=    (10000)
# DATABASE_STATEMENT_TIMEOUT_MS=  (60000)20

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fixa o timezone do processo Node em UTC para que a gravação/leitura de campos
# timestamp (ex: start_time/end_time de demandas) seja determinística, independente
# do timezone do host/container onde a aplicação roda.
# Não usar o nome "TZ" diretamente: é uma variável reservada em plataformas como a
# Vercel. instrumentation.ts lê esta variável e aplica em process.env.TZ no boot.
APP_TZ=UTC

# SOAP TOTVS RM
SOAP_DEFAULT_TIMEOUT=30000
SOAP_MAX_RETRIES=3
SOAP_RETRY_DELAY=1000

# Vercel Blob (upload de imagens: logo de Cliente e temas do Mapeador)
# Criado em Vercel Dashboard > Storage > Blob e conectado ao projeto — a Vercel
# injeta esta variável automaticamente em produção/preview. Para rodar local,
# copie o token da store (ou "vercel env pull") e cole aqui.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Não usada pelo código hoje (só é necessária se implementarmos upload client-side
# com callback de webhook) — mantida aqui só para espelhar o que a Vercel provisiona.
BLOB_WEBHOOK_PUBLIC_KEY=

# Upstash Redis (Vercel Marketplace injeta KV_REST_API_* ou UPSTASH_REDIS_REST_*). Sem elas: cache
# "use cache: remote", rate limit e cache de autenticação SOAP ficam em memória por instância.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Prefixo das chaves do cache do Next no Redis (útil para separar ambientes que dividem o mesmo Redis)
# CACHE_KEY_PREFIX=nc
# Por quanto tempo uma autenticação SOAP (AutenticaAcesso + CheckServiceActivity) bem-sucedida é
# reaproveitada por TBC/credencial (segundos; 0 desliga)
# SOAP_AUTH_CACHE_TTL_SECONDS=300

# Upstash QStash (fila de jobs e agendamentos). Sem QSTASH_TOKEN os jobs rodam no próprio processo
# logo após a resposta (after()). As chaves de assinatura protegem /api/jobs/* e /api/cron/*.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# URL pública que o QStash chama de volta (padrão: VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL)
# JOBS_BASE_URL=https://app.seudominio.com.br
# Alternativa/manual para disparar /api/cron/<tarefa> com "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=
# Docker/servidor de longa duração: "true" liga os agendamentos em processo (setInterval)
# RUN_INPROCESS_SCHEDULERS=true

# Telemetria: chamadas mais lentas que isto (ms) geram aviso no log (padrão 1000)
# SLOW_REQUEST_MS=1000
