# Database
DATABASE_URL="postgresql://admin:admin123@localhost:5432/integracao_totvs"
DB_NAME=integracao_totvs
DB_USER=admin
DB_PASS=admin123

# Porta no host para o Postgres do docker-compose (5432 padrão do container é sempre interno)
DB_PORT=5433

# Auth.js (gere com: npx auth secret)
AUTH_SECRET=change-this-to-a-long-random-string

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fixa o timezone do processo Node em UTC para que a gravação/leitura de campos
# timestamp (ex: start_time/end_time de demandas) seja determinística, independente
# do timezone do host/container onde a aplicação roda.
# Não usar o nome "TZ" diretamente: é uma variável reservada em plataformas como a
# Vercel. instrumentation.ts lê esta variável e aplica em process.env.TZ no boot.
APP_TZ=UTC

# SOAP TOTVS RM
SOAP_DEFAULT_TIMEOUT=30000
SOAP_MAX_RETRIES=3
SOAP_RETRY_DELAY=1000

# Vercel Blob (upload de imagens: logo de Cliente e temas do Mapeador)
# Criado em Vercel Dashboard > Storage > Blob e conectado ao projeto — a Vercel
# injeta esta variável automaticamente em produção/preview. Para rodar local,
# copie o token da store (ou "vercel env pull") e cole aqui.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Não usada pelo código hoje (só é necessária se implementarmos upload client-side
# com callback de webhook) — mantida aqui só para espelhar o que a Vercel provisiona.
BLOB_WEBHOOK_PUBLIC_KEY=
