# Database
DATABASE_URL="postgresql://admin:admin123@localhost:5432/integracao_totvs"
DB_NAME=integracao_totvs
DB_USER=admin
DB_PASS=admin123

# Porta no host para o Postgres do docker-compose (5432 padrão do container é sempre interno)
DB_PORT=5433

# Auth.js (gere com: npx auth secret)
AUTH_SECRET=change-this-to-a-long-random-string

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SOAP TOTVS RM
SOAP_DEFAULT_TIMEOUT=30000
SOAP_MAX_RETRIES=3
SOAP_RETRY_DELAY=1000

# Controla apenas a restauração de sentenças de backup para o RM
# (services/rm-sentence.service.ts): "mock" (padrão) não restaura nada — bom para dev.
# "live" restaura de fato via SOAP real (wsDataServer.SaveRecord), exigindo a variável
# abaixo. O backup em si (buscar as sentenças a partir de um Filtro) sempre lê a tabela
# real "sentences" deste banco, independente deste modo.
RM_SENTENCE_SERVICE_MODE=mock

# DataServerName do RM que representa a tabela GCONSSQL, usado por wsDataServer.SaveRecord
# ao restaurar uma sentença para um TBC — específico de cada instalação, não é possível
# descobrir isso pela documentação pública. Necessário apenas em modo "live".
RM_GCONSSQL_DATASERVER_NAME=
